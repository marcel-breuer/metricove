APP_PORT=8080
APP_IMAGE_TAG=local
# Optional per-image override. Set to <version>@sha256:<digest> to pin each image.
# API_IMAGE_TAG=
# WEB_IMAGE_TAG=
# GATEWAY_IMAGE_TAG=
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_KEY=base64:generate-with-scripts/prepare-compose-env.sh
# Comma-separated proxy IP addresses or CIDR networks that set X-Forwarded-For.
TRUSTED_PROXIES=

DB_DATABASE=metricove
DB_USERNAME=metricove
DB_PASSWORD=generate-with-scripts/prepare-compose-env.sh

# Session cookies default to Secure when APP_URL uses HTTPS. Set explicitly only to override that default.
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# SESSION_SECURE_COOKIE=true

# Local Compose sends email to Mailpit; open http://localhost:8026 to inspect messages.
# For a real deployment, replace the host and credentials with the installation SMTP server.
# Password reset emails are never written to application logs.
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Metricove
MAILPIT_UI_PORT=8026
# Enable the optional local email catcher with COMPOSE_PROFILES=mailpit.
# COMPOSE_PROFILES=mailpit

AUTH_PASSWORD_RESET_EXPIRE=60
AUTH_PASSWORD_RESET_THROTTLE=60
AUTH_INVITATION_EXPIRE=10080

# AI stays disabled unless a provider is configured. Supported providers are
# disabled, openai-compatible, claude, gemini and openrouter. Hosted requests
# require explicit user consent before question or tool data is sent.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_EXTERNAL_PROVIDER=false
AI_CONTEXT_RETENTION_DAYS=365
