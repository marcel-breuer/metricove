APP_PORT=8080
APP_IMAGE_TAG=local
# Optional per-image override. Set to <version>@sha256:<digest> to pin each image.
# API_IMAGE_TAG=
# WEB_IMAGE_TAG=
# GATEWAY_IMAGE_TAG=
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_KEY=base64:generate-with-scripts/prepare-compose-env.sh

DB_DATABASE=metricove
DB_USERNAME=metricove
DB_PASSWORD=generate-with-scripts/prepare-compose-env.sh

# Session cookies default to Secure when APP_URL uses HTTPS. Set explicitly only to override that default.
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# SESSION_SECURE_COOKIE=true

# Configure SMTP per installation. Password reset emails are never written to application logs.
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Metricove

AUTH_PASSWORD_RESET_EXPIRE=60
AUTH_PASSWORD_RESET_THROTTLE=60
AUTH_INVITATION_EXPIRE=10080

# AI stays disabled unless a compatible provider is configured. Set external=true
# for a hosted provider; each assistant request then requires explicit user consent.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_EXTERNAL_PROVIDER=false
AI_CONTEXT_RETENTION_DAYS=365
